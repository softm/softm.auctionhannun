{
  "name": "auction-at-a-glance",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "collect": "node scripts/collect-auctions.mjs",
    "collect:court-list": "node scripts/collect-court-list.mjs",
    "collect:onbid": "node scripts/collect-onbid.mjs",
    "collect:onbid:movable": "node scripts/collect-onbid-movable.mjs",
    "probe:onbid": "node scripts/probe-onbid.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && npm run validate:data && npm test"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.4.0"
  }
