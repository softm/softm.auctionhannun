{
  "name": "auction-at-a-glance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "collect": "node scripts/collect-auctions.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
